{
  "name": "pi-active-vaults",
  "version": "0.0.0",
  "description": "Active, Git-backed knowledge vaults for Pi",
  "keywords": [
    "pi-package"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "vault": "./dist/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "pi": {
    "extensions": [
      "./dist/extension/index.js"
    ]
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "tsc --noEmit",
    "smoke": "npm run build && node test/smoke/run.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^26.6.5",
    "typebox": "~1.3.27",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "croner": "10.0.1",
    "nodemailer": "^10.0.14",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.9.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerryjvl/pi-active-vaults.git"
  },
  "homepage": "https://github.com/jerryjvl/pi-active-vaults#readme",
  "bugs": {
    "url": "https://github.com/jerryjvl/pi-active-vaults/issues"
  }
}
